<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SpotiImparable" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:enableOnBackInvokedCallback">true</item>
    </style>

    <!-- Usada por LinkActivity: sin fondo ni animación, para que el salto desde
         el enlace de Spotify no parpadee. -->
    <style name="Theme.SpotiImparable.Transparent" parent="Theme.SpotiImparable">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
